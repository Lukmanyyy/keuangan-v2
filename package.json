{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev dist --d1 DB=00000000-0000-0000-0000-000000000000 --compatibility-date 2026-10-27 --compatibility-flags nodejs_compat",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run dev",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts tests/*.test.ts",
    "test:cloudflare": "tsx scripts/smoke.ts",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "jspdf": "^4.0.0",
    "write-excel-file": "^4.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "wrangler": "^4.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": { "node": ">=22.12.0" }
}
